# متغیرهای محیطی نمونه — این فایل commit می‌شود؛ .env واقعی هرگز commit نشود.

NODE_ENV=development

# اتصال PostgreSQL (Phase 1)
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/transportation?schema=public"

# کلید امضای session cookie — یک رشته تصادفی بلند و مخفی (مثلاً با: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
SESSION_SECRET="CHANGE_ME"

# حساب Admin اولیه — فقط برای seed استفاده می‌شود؛ کاربر باید در اولین ورود رمز را عوض کند.
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="CHANGE_ME_TEMP_PASSWORD"
