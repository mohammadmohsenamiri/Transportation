generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoleCode {
  MISSION_PLANNER
  STATUS_VIEWER
  ADMIN
}

model User {
  id                 String   @id @default(uuid())
  username           String   @unique
  passwordHash       String
  mustChangePassword Boolean  @default(true)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  roles    UserRole[]
  sessions Session[]

  createdOrganizationUnits OrganizationUnit[] @relation("OrganizationUnitCreatedBy")
  updatedOrganizationUnits OrganizationUnit[] @relation("OrganizationUnitUpdatedBy")
  createdMapProviders      MapProvider[]      @relation("MapProviderCreatedBy")
  updatedMapProviders      MapProvider[]      @relation("MapProviderUpdatedBy")
}

model Role {
  id   String   @id @default(uuid())
  code RoleCode @unique
  name String

  users UserRole[]
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Session {
  id         String    @id @default(uuid())
  userId     String
  secretHash String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  userAgent  String?
  ipAddress  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum OrganizationLevel {
  COUNTRY_OFFICE
  GROUP_OFFICE
  DISTRIBUTOR_OFFICE
  WAREHOUSE
}

model OrganizationUnit {
  id        String            @id @default(uuid())
  code      String            @unique
  name      String
  level     OrganizationLevel
  parentId  String?
  latitude  Decimal?          @db.Decimal(9, 6)
  longitude Decimal?          @db.Decimal(9, 6)
  address   String?
  isActive  Boolean           @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  parent   OrganizationUnit?  @relation("OrganizationUnitParent", fields: [parentId], references: [id])
  children OrganizationUnit[] @relation("OrganizationUnitParent")

  createdBy User? @relation("OrganizationUnitCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("OrganizationUnitUpdatedBy", fields: [updatedById], references: [id])

  @@index([parentId])
  @@index([level])
}

enum VehicleReadiness {
  READY
  OUT_OF_SERVICE
}

model VehicleType {
  id          String  @id @default(uuid())
  code        String? @unique
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  vehicles Vehicle[]

  @@index([isActive])
}

model CargoType {
  id          String  @id @default(uuid())
  code        String? @unique
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([isActive])
}

model Vehicle {
  id                     String           @id @default(uuid())
  identifier             String           @unique
  plateNumber            String?
  vehicleTypeId          String
  fuelTankLiters         Decimal          @db.Decimal(10, 2)
  avgConsumptionPer100Km Decimal          @db.Decimal(10, 3)
  avgSpeedKmh            Decimal          @db.Decimal(10, 2)
  readiness              VehicleReadiness @default(READY)
  notes                  String?
  isActive               Boolean          @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  vehicleType VehicleType @relation(fields: [vehicleTypeId], references: [id])

  @@index([vehicleTypeId])
  @@index([readiness])
}

enum MapProviderKind {
  INTERNAL_TMS
  INTERNAL_XYZ
  INTERNAL_WMTS
  EXTERNAL_XYZ
}

enum MapProviderHealthStatus {
  UNKNOWN
  HEALTHY
  UNHEALTHY
}

model MapProvider {
  id              String                  @id @default(uuid())
  name            String                  @unique
  kind            MapProviderKind
  urlTemplate     String
  attribution     String?
  minZoom         Int                     @default(0)
  maxZoom         Int                     @default(19)
  tileSize        Int                     @default(256)
  subdomains      Json?
  requiresApiKey  Boolean                 @default(false)
  secretReference String?
  isDefault       Boolean                 @default(false)
  isEnabled       Boolean                 @default(true)
  healthStatus    MapProviderHealthStatus @default(UNKNOWN)
  lastCheckedAt   DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  createdBy User? @relation("MapProviderCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("MapProviderUpdatedBy", fields: [updatedById], references: [id])

  @@index([isEnabled])
  @@index([isDefault])
}

model AuditLog {
  id           String   @id @default(uuid())
  actorUserId  String?
  action       String
  entityType   String
  entityId     String?
  beforeJson   Json?
  afterJson    Json?
  metadataJson Json?
  ipAddress    String?
  userAgent    String?
  occurredAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId])
}
