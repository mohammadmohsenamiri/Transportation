generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoleCode {
  MISSION_PLANNER
  STATUS_VIEWER
  ADMIN
}

model User {
  id                 String   @id @default(uuid())
  username           String   @unique
  passwordHash       String
  mustChangePassword Boolean  @default(true)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Phase 14 — همه افزایشی و nullable/پیش‌فرض‌دار، پس هیچ backfill لازم نیست.
  displayName      String?
  deletedAt        DateTime?
  lastLoginAt      DateTime?
  suspendedAt      DateTime?
  suspensionReason String?
  /**
   * توکن همروندی خوش‌بینانه — بدون معنای کسب‌وکاری (ADR-P14-09).
   */
  version          Int       @default(0)

  roles    UserRole[]
  sessions Session[]

  uploadedIcons   IconAsset[]     @relation("IconAssetUploadedBy")
  updatedSettings SystemSetting[] @relation("SystemSettingUpdatedBy")

  createdOrganizationUnits OrganizationUnit[] @relation("OrganizationUnitCreatedBy")
  updatedOrganizationUnits OrganizationUnit[] @relation("OrganizationUnitUpdatedBy")
  createdMapProviders      MapProvider[]      @relation("MapProviderCreatedBy")
  updatedMapProviders      MapProvider[]      @relation("MapProviderUpdatedBy")
  createdRoutes            Route[]            @relation("RouteCreatedBy")
  updatedRoutes            Route[]            @relation("RouteUpdatedBy")
  createdShipments         Shipment[]         @relation("ShipmentCreatedBy")
  updatedShipments         Shipment[]         @relation("ShipmentUpdatedBy")
  createdMissions          Mission[]          @relation("MissionCreatedBy")
  updatedMissions          Mission[]          @relation("MissionUpdatedBy")

  @@index([deletedAt])
  // نگهبان «آخرین مدیر فعال» و فهرست پیش‌فرض کاربران دقیقاً روی همین جفت فیلتر می‌کنند؛
  // بدون این ایندکس، آن نگهبان که داخل تراکنش با FOR UPDATE اجرا می‌شود جدول را sequential می‌خواند.
  @@index([isActive, deletedAt])
}

model Role {
  id   String   @id @default(uuid())
  code RoleCode @unique
  name String

  users UserRole[]
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Session {
  id         String    @id @default(uuid())
  userId     String
  secretHash String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  userAgent  String?
  ipAddress  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum OrganizationLevel {
  COUNTRY_OFFICE
  GROUP_OFFICE
  DISTRIBUTOR_OFFICE
  WAREHOUSE
}

model OrganizationUnit {
  id        String            @id @default(uuid())
  code      String            @unique
  name      String
  level     OrganizationLevel
  parentId  String?
  latitude  Decimal?          @db.Decimal(9, 6)
  longitude Decimal?          @db.Decimal(9, 6)
  address   String?
  isActive  Boolean           @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  parent   OrganizationUnit?  @relation("OrganizationUnitParent", fields: [parentId], references: [id])
  children OrganizationUnit[] @relation("OrganizationUnitParent")

  createdBy User? @relation("OrganizationUnitCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("OrganizationUnitUpdatedBy", fields: [updatedById], references: [id])

  shipmentOrigins      Shipment[] @relation("ShipmentOrigin")
  shipmentDestinations Shipment[] @relation("ShipmentDestination")
  missionOrigins       Mission[]  @relation("MissionOrigin")
  missionDestinations  Mission[]  @relation("MissionDestination")

  // Phase 14 — آیکن اختیاری. SetNull در کنار soft-delete: اگر روزی رکوردی سخت حذف شود،
  // ارجاع معلق نمی‌ماند و رندر نقشه نمی‌شکند.
  iconAssetId String?
  iconAsset   IconAsset? @relation(fields: [iconAssetId], references: [id], onDelete: SetNull)

  @@index([parentId])
  @@index([level])
  @@index([iconAssetId])
}

enum VehicleReadiness {
  READY
  OUT_OF_SERVICE
}

model VehicleType {
  id          String  @id @default(uuid())
  code        String? @unique
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  vehicles Vehicle[]

  iconAssetId String?
  iconAsset   IconAsset? @relation(fields: [iconAssetId], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([iconAssetId])
}

model CargoType {
  id          String  @id @default(uuid())
  code        String? @unique
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  shipments Shipment[]

  @@index([isActive])
}

model Vehicle {
  id                     String           @id @default(uuid())
  identifier             String           @unique
  plateNumber            String?
  vehicleTypeId          String
  fuelTankLiters         Decimal          @db.Decimal(10, 2)
  avgConsumptionPer100Km Decimal          @db.Decimal(10, 3)
  avgSpeedKmh            Decimal          @db.Decimal(10, 2)
  readiness              VehicleReadiness @default(READY)
  notes                  String?
  isActive               Boolean          @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  vehicleType VehicleType @relation(fields: [vehicleTypeId], references: [id])
  missions    Mission[]

  iconAssetId String?
  iconAsset   IconAsset? @relation(fields: [iconAssetId], references: [id], onDelete: SetNull)

  @@index([vehicleTypeId])
  @@index([readiness])
  @@index([iconAssetId])
}

enum MapProviderKind {
  INTERNAL_TMS
  INTERNAL_XYZ
  INTERNAL_WMTS
  EXTERNAL_XYZ
}

enum MapProviderHealthStatus {
  UNKNOWN
  HEALTHY
  UNHEALTHY
}

model MapProvider {
  id              String                  @id @default(uuid())
  name            String                  @unique
  kind            MapProviderKind
  urlTemplate     String
  attribution     String?
  minZoom         Int                     @default(0)
  maxZoom         Int                     @default(19)
  tileSize        Int                     @default(256)
  subdomains      Json?
  requiresApiKey  Boolean                 @default(false)
  secretReference String?
  isDefault       Boolean                 @default(false)
  isEnabled       Boolean                 @default(true)
  healthStatus    MapProviderHealthStatus @default(UNKNOWN)
  lastCheckedAt   DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  createdBy User? @relation("MapProviderCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("MapProviderUpdatedBy", fields: [updatedById], references: [id])

  @@index([isEnabled])
  @@index([isDefault])
}

enum RouteSource {
  CSV
  MAP_DRAWING
}

model Route {
  id                   String      @id @default(uuid())
  code                 String
  name                 String
  description          String?
  source               RouteSource
  originLatitude       Decimal     @db.Decimal(9, 6)
  originLongitude      Decimal     @db.Decimal(9, 6)
  destinationLatitude  Decimal     @db.Decimal(9, 6)
  destinationLongitude Decimal     @db.Decimal(9, 6)
  totalDistanceMeters  BigInt
  pointCount           Int
  checksum             String
  version              Int         @default(1)
  isActive             Boolean     @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  points   RoutePoint[]
  missions Mission[]

  createdBy User? @relation("RouteCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("RouteUpdatedBy", fields: [updatedById], references: [id])

  @@unique([code, version])
  @@index([code])
  @@index([isActive])
}

model RoutePoint {
  id                       String  @id @default(uuid())
  routeId                  String
  sequence                 Int
  latitude                 Decimal @db.Decimal(9, 6)
  longitude                Decimal @db.Decimal(9, 6)
  label                    String?
  cumulativeDistanceMeters BigInt

  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@unique([routeId, sequence])
}

enum ShipmentStatus {
  DRAFT
  WAITING_FOR_DISPATCH
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

model Shipment {
  id                            String         @id @default(uuid())
  trackingCode                  String         @unique
  title                         String
  cargoTypeId                   String
  originWarehouseId             String
  destinationOrganizationUnitId String?
  destinationTitle              String
  destinationLatitude           Decimal        @db.Decimal(9, 6)
  destinationLongitude          Decimal        @db.Decimal(9, 6)
  weightKg                      Decimal?       @db.Decimal(10, 2)
  volumeM3                      Decimal?       @db.Decimal(10, 3)
  notes                         String?
  status                        ShipmentStatus @default(DRAFT)
  isActive                      Boolean        @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  cargoType                   CargoType         @relation(fields: [cargoTypeId], references: [id])
  originWarehouse             OrganizationUnit  @relation("ShipmentOrigin", fields: [originWarehouseId], references: [id])
  destinationOrganizationUnit OrganizationUnit? @relation("ShipmentDestination", fields: [destinationOrganizationUnitId], references: [id])

  createdBy User? @relation("ShipmentCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("ShipmentUpdatedBy", fields: [updatedById], references: [id])

  missionLinks MissionShipment[]

  @@index([status])
  @@index([originWarehouseId])
  @@index([cargoTypeId])
  @@index([isActive])
}

enum MissionPersistedStatus {
  DRAFT
  SCHEDULED
  CANCELLED
  ARCHIVED
}

model Mission {
  id                            String                 @id @default(uuid())
  code                          String                 @unique
  vehicleId                     String
  originWarehouseId             String
  originTitle                   String
  originLatitude                Decimal                @db.Decimal(9, 6)
  originLongitude               Decimal                @db.Decimal(9, 6)
  destinationOrganizationUnitId String?
  destinationTitle              String
  destinationLatitude           Decimal                @db.Decimal(9, 6)
  destinationLongitude          Decimal                @db.Decimal(9, 6)
  startAt                       DateTime
  routeId                       String?
  routeVersion                  Int?
  speedSnapshotKmh              Decimal                @db.Decimal(10, 2)
  distanceMeters                BigInt
  estimatedDurationSeconds      Int
  estimatedArrivalAt            DateTime
  persistedStatus               MissionPersistedStatus @default(DRAFT)
  notes                         String?
  publishedAt                   DateTime?
  cancelledAt                   DateTime?
  cancellationReason            String?
  duplicatedFromMissionId       String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  vehicle                     Vehicle           @relation(fields: [vehicleId], references: [id])
  originWarehouse             OrganizationUnit  @relation("MissionOrigin", fields: [originWarehouseId], references: [id])
  destinationOrganizationUnit OrganizationUnit? @relation("MissionDestination", fields: [destinationOrganizationUnitId], references: [id])
  route                       Route?            @relation(fields: [routeId], references: [id])

  shipments MissionShipment[]

  createdBy User? @relation("MissionCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("MissionUpdatedBy", fields: [updatedById], references: [id])

  @@index([vehicleId])
  @@index([startAt])
  @@index([estimatedArrivalAt])
  @@index([persistedStatus])
  @@index([originWarehouseId])
}

model MissionShipment {
  id                 String   @id @default(uuid())
  missionId          String
  shipmentId         String
  isActiveAssignment Boolean  @default(false)
  createdAt          DateTime @default(now())

  mission  Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  shipment Shipment @relation(fields: [shipmentId], references: [id])

  @@unique([missionId, shipmentId])
  @@index([shipmentId])
}

model AuditLog {
  id           String   @id @default(uuid())
  actorUserId  String?
  action       String
  entityType   String
  entityId     String?
  beforeJson   Json?
  afterJson    Json?
  metadataJson Json?
  ipAddress    String?
  userAgent    String?
  occurredAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId])
}

// ---------------------------------------------------------------------------
// Phase 14 — کتابخانه آیکن و تنظیمات سامانه
// ---------------------------------------------------------------------------

/**
 * دسته آیکن — طبق ARCHITECTURE_AND_DATA_MODEL.md §IconAsset.
 * نگاشت به موجودیت‌ها عمداً یک‌به‌یک نیست: OFFICE سه سطح دفتری OrganizationLevel را
 * پوشش می‌دهد و WAREHOUSE یک سطح را. این دسته یک صافی سازمانی برای گالری مدیر است،
 * نه یک مرز صحت داده.
 */
enum IconCategory {
  VEHICLE
  OFFICE
  WAREHOUSE
  DESTINATION
  OTHER
}

model IconAsset {
  id       String       @id @default(uuid())
  name     String
  category IconCategory
  mimeType String

  /**
   * نسبی به ICON_ROOT — نه مطلق، تا جابه‌جایی محل ذخیره‌سازی نیازمند migration داده نباشد.
   */
  storagePath      String
  sha256           String
  width            Int?
  height           Int?
  fileSize         Int
  /**
   * فقط برای نمایش؛ هرگز برای ساختن مسیر فایل استفاده نمی‌شود (SEC-11).
   */
  originalFilename String?

  isActive Boolean @default(true)
  version  Int     @default(0)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  uploadedById String?

  uploadedBy        User?              @relation("IconAssetUploadedBy", fields: [uploadedById], references: [id])
  organizationUnits OrganizationUnit[]
  vehicleTypes      VehicleType[]
  vehicles          Vehicle[]

  @@index([category, isActive])
  @@index([deletedAt])
  @@index([sha256])
}

/**
 * تنظیمات سامانه — کلید/مقدار با نوع‌دهی از رجیستری کد، نه از ستون (ADR-P14-06).
 * رکوردها تنبل ساخته می‌شوند: کلیدِ بدون رکورد از مقدار پیش‌فرض رجیستری استفاده می‌کند،
 * پس این جدول دقیقاً «انحراف‌های اپراتور از پیش‌فرض» را نگه می‌دارد.
 */
model SystemSetting {
  key         String   @id
  value       Json
  version     Int      @default(0)
  updatedAt   DateTime @updatedAt
  updatedById String?

  updatedBy User? @relation("SystemSettingUpdatedBy", fields: [updatedById], references: [id])
}
