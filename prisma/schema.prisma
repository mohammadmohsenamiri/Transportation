generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoleCode {
  MISSION_PLANNER
  STATUS_VIEWER
  ADMIN
}

model User {
  id                 String   @id @default(uuid())
  username           String   @unique
  passwordHash       String
  mustChangePassword Boolean  @default(true)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  roles    UserRole[]
  sessions Session[]

  createdOrganizationUnits OrganizationUnit[] @relation("OrganizationUnitCreatedBy")
  updatedOrganizationUnits OrganizationUnit[] @relation("OrganizationUnitUpdatedBy")
}

model Role {
  id   String   @id @default(uuid())
  code RoleCode @unique
  name String

  users UserRole[]
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Session {
  id         String    @id @default(uuid())
  userId     String
  secretHash String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  userAgent  String?
  ipAddress  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum OrganizationLevel {
  COUNTRY_OFFICE
  GROUP_OFFICE
  DISTRIBUTOR_OFFICE
  WAREHOUSE
}

model OrganizationUnit {
  id        String            @id @default(uuid())
  code      String            @unique
  name      String
  level     OrganizationLevel
  parentId  String?
  latitude  Decimal?          @db.Decimal(9, 6)
  longitude Decimal?          @db.Decimal(9, 6)
  address   String?
  isActive  Boolean           @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  parent   OrganizationUnit?  @relation("OrganizationUnitParent", fields: [parentId], references: [id])
  children OrganizationUnit[] @relation("OrganizationUnitParent")

  createdBy User? @relation("OrganizationUnitCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("OrganizationUnitUpdatedBy", fields: [updatedById], references: [id])

  @@index([parentId])
  @@index([level])
}

model AuditLog {
  id           String   @id @default(uuid())
  actorUserId  String?
  action       String
  entityType   String
  entityId     String?
  beforeJson   Json?
  afterJson    Json?
  metadataJson Json?
  ipAddress    String?
  userAgent    String?
  occurredAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId])
}
